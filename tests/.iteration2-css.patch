diff --git a/dist/inventory.css b/dist/inventory.css
index 90b0c99..1b5f9c9 100644
--- a/dist/inventory.css
+++ b/dist/inventory.css
@@ -748,0 +749,26 @@
+
+/* Iteration 2: scoped guidance and clearer controls; retain the deployed stockroom. */
+.cr-game .cr-nav>button .cr-nav-label{display:block;width:auto;text-align:left;font-size:inherit;line-height:1.2}
+.cr-game .cr-nav-label small{display:block;font-size:10px;font-weight:400;margin-top:4px}
+.cr-game .cr-order-tools{flex:1;min-width:0;border:1px solid #bca37b;border-radius:8px;padding:7px;background:#fff6e4}
+.cr-game .cr-order-tools summary{cursor:pointer;font-weight:700;font-size:12px}
+.cr-game .cr-order-tools>div{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
+.cr-game .cr-order-tools button{min-width:0;white-space:normal}
+.cr-game .cr-profit-help{font-size:12px;margin:0;flex-shrink:0}
+.cr-game .cr-trend-summary>button{padding:10px;font-size:10px;text-align:center}
+.cr-game .cr-trend-summary>button b{display:block}
+.cr-game .cr-trend-layout{flex:1 0 auto;min-height:min-content}
+.cr-game .cr-event-summary{flex-shrink:0}
+.cr-game #cr-dock[data-delivery-state="new-stock"]{border-color:#4a7956;background:linear-gradient(#e2edc7,#b8d39b);animation:cr-dock-arrival .5s ease-out}
+.cr-sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
+#cr-tour-spotlight{position:fixed;inset:0;z-index:10002;pointer-events:none;overflow:hidden}
+#cr-tour-spotlight>svg{position:absolute;inset:0}
+#cr-tour-spotlight .cr-tour-ring{position:absolute;box-sizing:border-box;border:3px solid #c5162e;border-radius:8px}
+#cr-tour-spotlight .cr-tour-pointer{position:absolute;background:#9f1528;color:white;border-radius:5px;padding:3px 7px;font:800 11px/16px system-ui,sans-serif;white-space:nowrap}
+.cr-game .cr-tour-target,.cr-overlay .cr-tour-target{animation:none!important}
+.cr-game .cr-tour-target:after,.cr-overlay .cr-tour-target:after{display:none}
+@media(max-width:800px){.cr-game .cr-nav-label small{display:none}.cr-game .cr-nav>button .cr-nav-label{text-align:center}.cr-game .cr-trend-summary>button{padding:6px 3px;font-size:9px}.cr-game .cr-profit-help{font-size:11px}}
+@media(max-width:520px) and (min-height:741px){
+  .cr-game .cr-order-layout{grid-template-rows:minmax(0,1fr) auto}
+  .cr-game .cr-cart{grid-template-rows:auto minmax(min-content,1fr);min-height:min-content}
+}
